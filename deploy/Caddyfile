# ── ParvizOS · обратный прокси с автоматическим HTTPS ────────────
# Домен берётся из переменной DOMAIN (задаётся в .env рядом с compose).
# Caddy сам получает и продлевает сертификат Let's Encrypt — руками ничего
# делать не надо. Нужны лишь открытые порты 80 и 443 и A-запись домена
# на публичный IP сервера.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy parviz:3000
}
