# ── ParvizOS ──────────────────────────────────────────────
# Скопируй в .env.local и поменяй значения.

# Пароль для входа (это личный сервис — придумай свой)
APP_PASSWORD=change-me

# Секрет для подписи куки сессии.
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Ключ шифрования паролей в менеджере паролей (AES-256-GCM).
# Сгенерировать: openssl rand -hex 32
# Если не задан — берётся AUTH_SECRET. ВАЖНО: не меняй его после того,
# как сохранил пароли, иначе их будет не расшифровать.
# PASSWORD_SECRET=

# Где лежит база данных (файл SQLite). По умолчанию ./data/parviz.db
DATABASE_URL=file:./data/parviz.db

# Токен доступа для удалённой БД (libSQL/Turso).
# Нужен только если DATABASE_URL указывает на удалённый сервер, а не файл.
# DATABASE_AUTH_TOKEN=

# ── Для развёртывания на сервере (docker-compose.prod.yml) ────────

# Домен, на котором будет жить ParvizOS. На него Caddy сам возьмёт HTTPS.
# A-запись этого домена должна указывать на публичный IP сервера.
DOMAIN=parvizos.example.com

# Часовой пояс для расчёта «сегодня».
APP_TIMEZONE=Europe/Moscow

# Базовая валюта — в неё сводятся капитал и аналитика.
APP_BASE_CURRENCY=RUB

# ── Объектное хранилище для медиа (опционально) ───────────────────
# Если заданы все пять — аудио треков хранится в S3-совместимом хранилище
# (напр. Oracle Object Storage), а диск сервера остаётся пустым. Пусто — на диск.
# Oracle: endpoint = https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Ключи: OCI → профиль (справа вверху) → Customer Secret Keys → Generate.
# S3_ENDPOINT=https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
# S3_REGION=eu-frankfurt-1
# S3_BUCKET=parviz-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
